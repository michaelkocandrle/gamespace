    {"name": "e_sharpen_hull", "camera": "chase", "altitude_m": 3000, "facing": "horizon", "hud": 0, "gear": false, "speed_ms": 120, "chase_yaw": 150, "chase_pitch": -22, "chase_zoom": 0.3, "settle": 2.0},

    {"name": "f_tsr_history_cockpit", "camera": "cockpit", "altitude_m": 3000, "facing": "horizon", "hud": 1, "speed_ms": 120, "settle": 3.0,
     "console": ["r.TSR.History.ScreenPercentage 200"]},
