# ---------------------------------------------------------------------------
# Unreal Engine - generated / derived data
# ---------------------------------------------------------------------------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Platforms/*/Binaries/
Platforms/*/Build/
Platforms/*/Intermediate/

# Plugin-local generated data
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Stray build artefacts outside the folders above
*.tmp
*.pdb

# ---------------------------------------------------------------------------
# IDE / toolchain
# ---------------------------------------------------------------------------
# Visual Studio
.vs/
.vsconfig
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Rider / JetBrains
.idea/
*.sln.DotSettings.user

# Visual Studio Code (keep shared settings, drop local ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Xcode (macOS)
*.xcodeproj/
*.xcworkspace/

# Makefiles generated by UBT on Linux
Makefile
CMakeLists.txt
.ignore

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Content that should never be committed
# ---------------------------------------------------------------------------
# Per-user developer folders in the Content Browser
Content/Developers/

# Autosaves / editor backups
Content/**/*_BuiltData.uasset.tmp
*.autosave

# Local-only config overrides
Config/*Local*.ini

# Python bytecode from editor scripting (Content/Python)
__pycache__/
*.pyc

# Blender backups
*.blend1
*.blend2

# A font the player drops in for the HUD (Tools: SpaceFlightHud CustomFont); it may not be redistributable.
Content/UI/Fonts/Custom/
